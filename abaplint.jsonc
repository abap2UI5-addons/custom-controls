{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      // the abap2UI5 framework these controls plug into - cloned by abaplint
      // for dependency resolution (z2ui5_if_app, z2ui5_if_client,
      // z2ui5_cl_ui5_view_builder)
      "url": "https://github.com/abap2UI5/abap2UI5",
      // main on purpose, declared rather than left off - without the key
      // abaplint clones the default branch silently (abap2UI5 CONVENTIONS §9)
      "branch": "main",
      "files": "/src/**/*.*"
    },
    {
      // SAP standard objects abaplint cannot know by itself - here
      // if_serializable_object, which every custom filter/mapper handed to
      // client->_bind( ) has to implement. Same dependency the abap2UI5
      // samples repository uses.
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y)"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_subrc": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "allowed_object_types": {
      // WAPA is the BSP application Z2UI5_CCI that carries the custom-control
      // JavaScript, SICF are the ICF nodes it is served from (both generated
      // from app/webapp by 'npm run app2bsp')
      "allowed": ["CLAS", "DEVC", "INTF", "WAPA", "SICF"]
    },
    "obsolete_statement": true,
    "7bit_ascii": true,
    "line_length": {
      "maxIssuesPerFile": 10,
      "length": 255
    },
    "object_naming": {
      "ignoreNames": [],
      "ignorePatterns": [],
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z",
      "sxci": "^Z",
      "enhs": "^Z",
      "enho": "^Z",
      "cmod": "^Z",
      "form": "^Z",
      "sfpf": "^Z",
      "sfpi": "^Z",
      "aqqu": "^Z",
      "aqsg": "^Z",
      "aqbg": "^Z",
      "suso": "^Z",
      "sucu": "^Z",
      "wdya": "^Z",
      "wdyn": "^Z",
      "patternKind": "required",
      // Z2UI5_CL_CCI_* - same shape as the framework and the samples
      // repository use, not the generic ZCL_ prefix
      "clas": "^Z2UI5_CL_|^Z2UI5_CX_",
      "intf": "^Z2UI5_IF_"
    },
    // --- from abap2UI5's rule set (abap2UI5/abaplint.jsonc); src/01 is the
    // generated BSP, whitespace_end skips it ---
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "ambiguous_statement": true,
    "avoid_use": {
      "break": true,
      "defaultKey": true,
      "define": true,
      "describeLines": true,
      "exclude": [],
      "exportToDatabase": true,
      "exportToMemory": true,
      "severity": "Error",
      "skipQuickFix": false,
      "statics": true,
      "testSeams": true
    },
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_comments": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "cyclomatic_complexity": {
      "exclude": [],
      "max": 10,
      "severity": "Error"
    },
    "dangerous_statement": {
      "editorCallForReport": true,
      "ignoreRAPQueryProvider": true,
      "deleteDynpro": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "dynamicSQL": true,
      "exclude": [],
      "execSQL": true,
      "exportDynpro": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "insertReport": true,
      "insertTextpool": true,
      "kernelCall": true,
      "severity": "Error",
      "systemCall": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "downport": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "at": true,
      "case": true,
      "catch": true,
      "do": true,
      "exclude": [],
      "if": true,
      "loop": true,
      "loopAllowIfSubrc": true,
      "select": true,
      "try": true,
      "when": false,
      "while": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "exporting": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "if_in_if": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_"
      ],
      "exclude": []
    },
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_length": {
      "checkFunctionModules": true,
      "checkForms": true,
      "errorWhenEmpty": false,
      "exclude": [],
      "ignoreTestClasses": true,
      "severity": "Error",
      "statements": 50
    },
    "method_overwrites_builtin": {
      "exclude": [],
      "severity": "Error"
    },
    "mix_returning": true,
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "no_yoda_conditions": true,
    "nrob_consistency": true,
    "omit_parameter_name": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {
      "omitMeInstanceCalls": true,
      "exclude": [],
      "severity": "Warning"
    },
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_add_order_by": true,
    "select_performance": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "lines": 4,
      "exclude": [],
      "severity": "Warning"
    },
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": true,
    "use_bool_expression": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "whitespace_end": {
      "exclude": [
        "/src/01/"
      ]
    },
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    "xml_consistency": true,
    // added 2026-11: the rules of abap2UI5's abaplint.jsonc this repository
    // passes without a finding, with its settings, and allowed_object_types
    // with the object types this repository ships
    "abapdoc_html_tag": true,
    "abapdoc_leading_at": true,
    "abapdoc_parameter_names": true,
    "abapdoc_shorttext_length": true,
    "bound_check_after_create": true,
    "cds_comment_style": true,
    "cds_legacy_view": true,
    "changing_sorted_line": true,
    "clear_after_declaration": true,
    "clear_before_overwrite": true,
    "constant_condition": true,
    "copy_of_initial_variable": true,
    "delete_index_in_loop": true,
    // an allow list matching no object: the default, empty, allows every one
    "forbidden_kernel_write": {
      "allow": [
        "^$"
      ]
    },
    "inline_packed_computation": true,
    "is_assigned_in_loop": true,
    "no_mandt_in_database_operations": true,
    "range_row_values": true,
    "redundant_cast": true,
    "smim_consistency": true,
    "sort_empty_key": true,
    "subrc_after_assign": true,
    // added 2026-11 with their findings fixed. Exceptions: the BSP pages keep
    // their bytes (final_newline), imagemapster marks single optional parameters
    // ##NEEDED inside the METHODS statement (pragma_style), and three PUBLIC
    // constant groups are API for apps, not variables (unused_variables)
    "short_case": true,
    "final_newline": {
      "exclude": [
        "\\.wapa\\."
      ]
    },
    "pragma_style": {
      "style": "upper",
      "exclude": [
        "z2ui5_cl_cci_imagemapster\\."
      ]
    },
    "unused_variables": {
      "skipAbstract": false,
      "skipNames": [
        "cs_buttons",
        "cs_modifier",
        "cs_exit"
      ]
    },
    // added 2026-11: newer abaplint rules that report nothing here
    "abapdoc_short_link": true,
    "boolean_flag_via_if": true,
    "cast_via_generic_reference": true,
    // added 2026-11 with abaplint 2.120.116: every remaining rule of
    // 'abaplint --default', with the settings of abap2UI5's app rule set
    // (.github/abaplint/app-rules.json) or its own abaplint.jsonc where those
    // switch it on. Findings fixed in the same change.
    "abapdoc": true,
    "align_pseudo_comments": true,
    "align_type_expressions": true,
    "alias_never_reassigned": true,
    "bdef_check_syntax": true,
    "bdef_parser_error": true,
    "cds_check_syntax": true,
    "cds_naming": {
      "basicInterfaceView": "Z2UI5_",
      "compositeInterfaceView": "Z2UI5_",
      "consumptionView": "Z2UI5_",
      "basicRestrictedReuseView": "Z2UI5_",
      "compositeRestrictedReuseView": "Z2UI5_",
      "privateView": "Z2UI5_",
      "remoteAPIView": "Z2UI5_",
      "viewExtend": "Z2UI5_",
      "extensionIncludeView": "Z2UI5_",
      "derivationFunction": "Z2UI5_",
      "abstractEntity": "Z2UI5_"
    },
    "character_field_literal_blanks": true,
    "commented_code": true,
    "copy_chain": true,
    "definitions_top": true,
    "double_space": {
      "skipKeywords": ["CHANGING","EXPORTING","OTHERS"],
      "keywords": false,
      "startParen": true,
      "endParen": false,
      "afterColon": true
    },
    "field_symbol_never_assigned": true,
    // statements with a successor that this repository no longer uses -
    // listed so they do not come back (abaplint 2.120.116+). CREATE OBJECT
    // is not listed: the overview creates the demo app from a class name
    // resolved at runtime (CREATE OBJECT ... TYPE (name)), which NEW cannot
    "forbidden_statement": {
      "statements": [
        "Describe",
        "Refresh",
        "Ranges",
        "SelectLoop",
        "Collect",
        "Overlay",
        "Leave",
        "TypePools",
        "Perform",
        "Form",
        "Write",
        "ReadTable",
        "Append",
        "MoveCorresponding",
        "GetReference",
        "Concatenate",
        "Condense",
        "Translate",
        "Replace",
        "Find",
        "Shift",
        "Check"
      ]
    },
    "function_module_parameter_names": true,
    "generic_regex": true,
    "indentation": true,
    "inline_generic_source": true,
    "keyword_case": {
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "ignoreFunctionModuleName": false,
      "ignoreGlobalClassBoundaries": false,
      "maxIssuesPerFile": 10,
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreKeywords": []
    },
    "line_only_punc": true,
    "local_class_naming": {
      "ignoreNames": [],
      "ignorePatterns": [],
      "patternKind": "required",
      "local": "^LCL_.+$",
      "exception": "^LCX_.+$",
      "test": "^LTCL_.+$"
    },
    "loop_target_misuse": true,
    "no_exclamation_escape": true,
    "no_macros": true,
    // the sample launcher instantiates the sample it was asked for by name
    "no_dynamic_stuff": {
      "callMethod": true,
      "callFunction": true,
      "callDatabaseProcedure": true,
      "callTransformation": true,
      "callTransaction": true,
      "perform": true,
      "submit": true,
      "createObject": true,
      "createData": true,
      "getBadi": true,
      "assign": true,
      "internalTable": true,
      "exportImport": true,
      "exclude": [
        "z2ui5_cl_cci_sample_00\\.clas\\."
      ]
    },
    "prefer_corresponding": true,
    "prefer_inline": true,
    "prefer_inline_cast": true,
    "prefer_insert_into_table": true,
    "prefer_raise_message": true,
    "selection_screen_texts_missing": true,
    "sequential_read_sorted": true,
    "sort_required": true,
    "space_before_colon": true,
    "space_before_dot": true,
    "stale_subrc": true,
    "start_at_tab": true,
    "suspicious_loop": true,
    "sy_read_restriction": true,
    "try_cast_empty_catch": true,
    "types_naming": {
      "pattern": "^TY_"
    },
    "unhandled_classic_exception": {
      "missingOthers": true,
      "missingExceptions": true,
      "missingErrorMessage": true,
      "allowLiteralArguments": true
    },
    "unit_test_assertions": true,
    "unnecessary_copy": true,
    // --- OFF on purpose ---
    // Naming conventions this repository does not follow - it names variables,
    // parameters and attributes by the abap2UI5 house style (plain names in
    // the samples, lv_/ls_/mv_ in the controls), not by one prefix scheme;
    // the same four are off in abap2UI5 and in its app rule set
    "class_attribute_names": false,
    "local_variable_names": false,
    "method_parameter_names": false,
    "no_prefixes": false,
    // The controls are builders whose configuration structures are PUBLIC
    // attributes by design (cs_* constants, the typed config an app fills);
    // making them private is an API change, not a lint fix. Off in abap2UI5 too
    "no_public_attributes": false,
    // These fight the z2ui5_cl_ui5_view_builder chain layout (abap2UI5
    // .claude/skills/view-chain-layout): one call per line, n/v on two lines,
    // a blank line opening a control's content, end( ) in the column of the
    // ele( ) it closes, a subtree held in a variable for the next statement.
    // align_parameters and line_break_multiple_parameters are off in abap2UI5
    // and its app rule set for the same reason
    "align_parameters": false,
    "empty_line_in_statement": false,
    "in_statement_indentation": false,
    "keep_single_parameter_on_one_line": false,
    "line_break_multiple_parameters": false,
    "single_use_expression_temp": false,
    // Long texts (HTML, CSS, SVG for the samples) are split over lines with
    // && to stay under 255 characters; a string template would have to escape
    // every { } of the CSS/JS they carry. Off in the app rule set too
    "prefer_string_template": false,
    // LOOP AT ... INTO DATA( ) is the house style; hoisting every loop target
    // to the top of the method is a rewrite of every LOOP, not a fix. Off in
    // abap2UI5 and its app rule set too
    "no_inline_in_optional_branches": false
  }
}
