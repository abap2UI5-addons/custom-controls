{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      // the abap2UI5 framework these controls plug into - cloned by abaplint
      // for dependency resolution (z2ui5_if_app, z2ui5_if_client,
      // z2ui5_if_exit, z2ui5_cl_ui5_view_builder)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      // SAP standard objects abaplint cannot know by itself - here
      // if_serializable_object, which every custom filter/mapper handed to
      // client->_bind( ) has to implement. Same dependency the abap2UI5
      // samples repository uses.
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y)"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_subrc": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "allowed_object_types": {
      // WAPA is the BSP application Z2UI5_CCI that carries the custom-control
      // JavaScript, SICF are the ICF nodes it is served from (both generated
      // from app/webapp by 'npm run app2bsp')
      "allowed": ["CLAS", "DEVC", "INTF", "WAPA", "SICF"]
    },
    "obsolete_statement": true,
    "definitions_top": false,
    "7bit_ascii": true,
    "line_length": {
      "length": 255
    },
    "object_naming": {
      "patternKind": "required",
      // Z2UI5_CL_CCI_* - same shape as the framework and the samples
      // repository use, not the generic ZCL_ prefix
      "clas": "^Z2UI5_CL_|^Z2UI5_CX_",
      "intf": "^Z2UI5_IF_"
    },
    // --- from abap2UI5's rule set (abap2UI5/abaplint.jsonc); src/01 is the
    // generated BSP, whitespace_end skips it ---
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "ambiguous_statement": true,
    "avoid_use": {
      "break": true,
      "defaultKey": true,
      "define": true,
      "describeLines": true,
      "exclude": [],
      "exportToDatabase": true,
      "exportToMemory": true,
      "severity": "Error",
      "skipQuickFix": false,
      "statics": true,
      "testSeams": true
    },
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_comments": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "cyclomatic_complexity": {
      "exclude": [],
      "max": 10,
      "severity": "Error"
    },
    "dangerous_statement": {
      "deleteDynpro": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "dynamicSQL": true,
      "exclude": [],
      "execSQL": true,
      "exportDynpro": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "insertReport": true,
      "insertTextpool": true,
      "kernelCall": true,
      "severity": "Error",
      "systemCall": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "downport": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "at": true,
      "case": true,
      "catch": true,
      "do": true,
      "exclude": [],
      "if": true,
      "loop": false,
      "select": true,
      "try": true,
      "when": false,
      "while": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "exporting": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "if_in_if": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_"
      ],
      "exclude": []
    },
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_length": {
      "checkForms": true,
      "errorWhenEmpty": false,
      "exclude": [],
      "ignoreTestClasses": true,
      "severity": "Error",
      "statements": 50
    },
    "method_overwrites_builtin": {
      "exclude": [],
      "severity": "Error"
    },
    "mix_returning": true,
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "no_yoda_conditions": true,
    "nrob_consistency": true,
    "omit_parameter_name": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {
      "exclude": [],
      "severity": "Warning"
    },
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_add_order_by": true,
    "select_performance": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "exclude": [],
      "severity": "Warning"
    },
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": true,
    "use_bool_expression": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "whitespace_end": {
      "exclude": [
        "/src/01/"
      ]
    },
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    "xml_consistency": true
  }
}
