{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      // the abap2UI5 framework these controls plug into - cloned by abaplint
      // for dependency resolution (z2ui5_if_app, z2ui5_if_client,
      // z2ui5_if_exit, z2ui5_cl_ui5_view_builder)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      // SAP standard objects abaplint cannot know by itself - here
      // if_serializable_object, which every custom filter/mapper handed to
      // client->_bind( ) has to implement. Same dependency the abap2UI5
      // samples repository uses.
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y)"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_subrc": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "allowed_object_types": {
      // WAPA is the BSP application Z2UI5_CCI that carries the custom-control
      // JavaScript, SICF are the ICF nodes it is served from (both generated
      // from app/webapp by 'npm run app2bsp')
      "allowed": ["CLAS", "DEVC", "INTF", "WAPA", "SICF"]
    },
    "obsolete_statement": true,
    "definitions_top": false,
    "7bit_ascii": true,
    "line_length": {
      "length": 255
    },
    "object_naming": {
      "patternKind": "required",
      // Z2UI5_CL_CCI_* - same shape as the framework and the samples
      // repository use, not the generic ZCL_ prefix
      "clas": "^Z2UI5_CL_|^Z2UI5_CX_",
      "intf": "^Z2UI5_IF_"
    }
  }
}
