{
  "name": "custom-controls",
  "version": "0.0.1",
  "private": true,
  "description": "abap2UI5 custom controls shipped outside the framework",
  "type": "module",
  "scripts": {
    "app2bsp": "node tools/app2bsp.mjs",
    "vendor": "node tools/vendor.mjs",
    "vendor:local": "node tools/vendor.mjs --local",
    "build:local": "npm run vendor:local && npm run app2bsp",
    "lint": "abaplint abaplint.jsonc",
    "lint:702": "abaplint .github/abaplint/abap_702.jsonc",
    "syfixes": "find src -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} +",
    "downport": "abaplint --fix .github/abaplint/abap_702.jsonc && npm run syfixes",
    "test": "node --test 'tools/**/*.test.mjs'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/custom-controls.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/custom-controls/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/custom-controls#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.119.66",
    "@fortawesome/fontawesome-free": "6.5.2",
    "acorn": "^8.15.0",
    "animate.css": "4.1.1",
    "bwip-js": "4.1.1",
    "chart.js": "4.4.1",
    "chartjs-chart-venn": "4.2.7",
    "chartjs-chart-wordcloud": "4.3.2",
    "chartjs-plugin-annotation": "3.0.1",
    "chartjs-plugin-autocolors": "0.3.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "chartjs-plugin-deferred": "2.0.0",
    "dompurify": "3.1.6",
    "driver.js": "1.3.1",
    "imagemapster": "1.5.4",
    "marked": "12.0.2"
  }
}
