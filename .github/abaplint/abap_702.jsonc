{
  // The 7.02 configuration, used twice: `npm run downport` rewrites the
  // sources with `abaplint --fix` against it, and the abap-702 job lints the
  // result. What comes out is pushed to the `702` branch by publish-702.
  //
  // Paths are relative to this file, so the same config works from the
  // repository root (abaplint resolves "files" against the config location).
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      // open-abap-core rather than the Steampunk API intersect the standard
      // config uses: on 7.02 the classes these controls touch come from the
      // old kernel, and the intersect only describes what is available in
      // ABAP Cloud as well.
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // the downported framework - the 702 branch of abap2UI5, not main.
      // Against main, every type abap2UI5 declares WITH EMPTY KEY would be
      // reported as unknown here.
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "branch": "702",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "^(Z|Y)"
  },
  "rules": {
    "downport": true,
    // 7.02 has no inline declarations, so every DATA has to be at the top
    "definitions_top": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    "allowed_object_types": {
      // same set as the standard config: the BSP application and its ICF
      // nodes are generated from app/webapp and ship on every branch
      "allowed": ["CLAS", "DEVC", "INTF", "WAPA", "SICF"]
    }
  }
}
